# ===== روی سرور با نام .env.production کپی کن (chmod 600) و هیچ‌وقت commit نکن =====
# رمزها را با «openssl rand -hex 24» بساز (فقط hex؛ کاراکتر خاص آدرس اتصال را خراب می‌کند)

PLATFORM_DOMAIN=myapp.com
ACME_EMAIL=you@example.com

# ایمیج‌ها (CI می‌سازد). IMAGE_TAG را دیپلوی خودکار به‌روز می‌کند
IMAGE_PREFIX=ghcr.io/sohilpro/sazino
IMAGE_TAG=latest

# Caddy / DNS (توکن Cloudflare با Zone:DNS:Edit و Zone:Zone:Read)
CLOUDFLARE_API_TOKEN=change-me
# IPهای مجاز پنل ادمین، با فاصله (CIDR هم می‌شود)
ADMIN_ALLOWED_IPS=203.0.113.10

# دیتابیس / Redis / MinIO
POSTGRES_USER=myapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=myapp
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=myapp-media

# رمزها: openssl rand -hex 48 | openssl rand -base64 32 | openssl rand -hex 24
JWT_ACCESS_SECRET=change-me-at-least-32-characters-change-me-0000
ENCRYPTION_KEY=change-me-base64-32-bytes=
INTERNAL_API_TOKEN=change-me-at-least-32-characters-0000

# پیامک ملی‌پیامک (رمز قدیمی که لو رفته را حتماً عوض کن)
MELI_SMS_USER=change-me
MELI_SMS_PASS=change-me
MELI_SMS_PATTERN_OTP=0
MELI_SMS_PATTERN_ORDER=
MELI_SMS_PATTERN_SHIPPED=

# درگاه: تا مرچنت واقعی نیامده sandbox بماند
ZARINPAL_SANDBOX=true

# ایمیل: none یا smtp (با SMTP_URL و MAIL_FROM)
MAIL_DRIVER=none
SMTP_URL=
MAIL_FROM=

# IP عمومی سرور (برای دامنه‌ی اختصاصی بدون CNAME؛ اختیاری)
DOMAIN_SERVER_IPS=203.0.113.10

# بعد از تست یک دامنه‌ی اختصاصی true شود
CANONICAL_REDIRECT=false