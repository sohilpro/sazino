NODE_ENV=development

# Postgres (docker-compose هم از همین‌ها می‌خواند)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myapp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myapp

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=myapp-media
MINIO_ENDPOINT=http://localhost:9000

# API
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Nuxt (storefront و dashboard)
NUXT_PUBLIC_API_BASE=http://localhost:4000/api

# Auth
JWT_ACCESS_SECRET=22e113ff28726fab0d0abc4047b805c835316a1da5bdf7817fc6b333cc407ffe22c336a87563405fd71a440a005679b4
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Tenancy
# در پروداکشن دامنه‌ی اصلی پلتفرم، مثلاً myapp.com
PLATFORM_DOMAIN=localhost

# S3 / MinIO
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
# آدرسی که مرورگر تصاویر را از آن می‌خواند (در پروداکشن: CDN یا دامنه‌ی media)
MEDIA_PUBLIC_URL=http://localhost:9000/myapp-media

# SMS: console (توسعه) یا melipayamak (پروداکشن)
SMS_DRIVER=console
# MELI_SMS_USER=
# MELI_SMS_PASS=
# MELI_SMS_PATTERN_OTP=
# MELI_SMS_PATTERN_ORDER=

# تعداد proxyهای مورد اعتماد جلوی API (Nuxt جلوی API است، پس ۱)
TRUST_PROXY_HOPS=1

# کلید رمزنگاری (AES-256-GCM) اطلاعات حساس فروشگاه‌ها؛ ۳۲ بایت base64
# این کلید را جای امن نگه دار: با گم‌شدنش فروشنده‌ها باید شناسه‌ی درگاه را دوباره وارد کنند
ENCRYPTION_KEY=

# درگاه پرداخت: fake (توسعه و تست) یا zarinpal (پروداکشن)
PAYMENT_DRIVER=fake
ZARINPAL_SANDBOX=false

# صف و jobها (در تست خودکار خاموش می‌شود)
JOBS_ENABLED=true
QUEUE_PREFIX=myapp

# آدرس پنل فروشنده (لینک داخل ایمیل‌ها)
DASHBOARD_URL=http://localhost:3001

# ایمیل: console (توسعه)، smtp (پروداکشن) یا none (غیرفعال)
MAIL_DRIVER=console
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM="فروشگاه‌ساز <no-reply@example.com>"

# پترن پیامک ارسال سفارش: {0}=شماره‌ی سفارش  {1}=کد رهگیری
# MELI_SMS_PATTERN_SHIPPED=

# آدرس ویترین هر فروشگاه (پیوند پیش‌نمایش و «مشاهده‌ی فروشگاه»)؛ {subdomain} جایگزین می‌شود
# پروداکشن مثلاً: https://{subdomain}.myapp.com
STOREFRONT_URL_TEMPLATE=http://{subdomain}.localhost:3000

# دامنه‌ی اختصاصی: هدف CNAME که فروشنده‌ها باید به آن اشاره کنند (پیش‌فرض: stores.<PLATFORM_DOMAIN>)
# DOMAIN_CNAME_TARGET=stores.myapp.com
# IPهای سرور لبه (جداشده با کاما) برای دامنه‌ی اصلی بدون CNAME؛ اختیاری
# DOMAIN_SERVER_IPS=203.0.113.10
DNS_RESOLVERS=1.1.1.1,8.8.8.8
# بررسی روزانه‌ی مالکیت دامنه‌های تأییدشده (در توسعه false؛ دامنه‌های seed رکورد TXT واقعی ندارند)
DOMAIN_REVALIDATE=false

# توکن مشترک Caddy و API برای endpoint داخلی (حداقل ۳۲ کاراکتر)
# با این دستور بساز: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_API_TOKEN=
ACME_EMAIL=you@example.com