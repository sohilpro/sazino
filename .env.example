NODE_ENV=development

# Postgres (docker-compose هم از همین‌ها می‌خواند)
POSTGRES_USER=myapp
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myapp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://myapp:postgres@localhost:5432/myapp?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=myapp-media
MINIO_ENDPOINT=http://localhost:9000

# API
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Nuxt (storefront و dashboard)
NUXT_PUBLIC_API_BASE=http://localhost:4000/api