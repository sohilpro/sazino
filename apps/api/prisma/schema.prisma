generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

enum TenantPlan {
    FREE
    BASIC
    PRO
}

enum TenantStatus {
    ACTIVE
    SUSPENDED
}

enum UserRole {
    OWNER
    ADMIN
    EDITOR
}

enum DomainStatus {
    PENDING
    VERIFIED
    FAILED
}

enum ProductStatus {
    DRAFT
    ACTIVE
    ARCHIVED
}

enum OrderStatus {
    PENDING
    PAID
    SHIPPED
    CANCELED
}

enum PaymentGateway {
    ZARINPAL
    MANUAL
}

enum PaymentStatus {
    INITIATED
    PAID
    FAILED
}

/// هر فروشگاه یک Tenant است
model Tenant {
    id        String       @id @default(uuid(7)) @db.Uuid
    name      String
    /// همیشه lowercase ذخیره شود (در لایه‌ی سرویس نرمال می‌کنیم)
    subdomain String       @unique
    plan      TenantPlan   @default(FREE)
    status    TenantStatus @default(ACTIVE)
    /// تنظیمات انعطاف‌پذیر (لوگو، رنگ، اطلاعات تماس و ...)
    settings  Json         @default("{}")
    createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

    users   User[]
    domains Domain[]

    categories       Category[]
    products         Product[]
    variants         Variant[]
    inventories      Inventory[]
    customers        Customer[]
    customerSessions CustomerSession[]
    carts            Cart[]
    cartItems        CartItem[]

    media         Media[]
    productImages ProductImage[]

    shippingMethods   ShippingMethod[]
    customerAddresses CustomerAddress[]
    orderCounter      OrderCounter?
    orders            Order[]
    orderItems        OrderItem[]

    paymentGatewayConfigs PaymentGatewayConfig[]
    payments              Payment[]

    pages Page[]

    @@map("tenants")
}

/// فروشنده و کارمندان او (نه مشتری نهایی فروشگاه)
model User {
    id            String         @id @default(uuid(7)) @db.Uuid
    tenantId      String         @map("tenant_id") @db.Uuid
    refreshTokens RefreshToken[]
    /// همیشه lowercase ذخیره شود
    email         String         @unique
    passwordHash  String         @map("password_hash")
    name          String
    role          UserRole       @default(EDITOR)
    isActive      Boolean        @default(true) @map("is_active")
    lastLoginAt   DateTime?      @map("last_login_at") @db.Timestamptz(3)
    createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    @@index([tenantId])
    @@map("users")
}

model Domain {
    id                String       @id @default(uuid(7)) @db.Uuid
    tenantId          String       @map("tenant_id") @db.Uuid
    /// دامنه‌ی ادعاشده (lowercase، punycode). چند فروشگاه می‌توانند هم‌زمان یک دامنه را «در انتظار» داشته باشند
    hostname          String
    /// فقط وقتی تأیید شده برابر hostname است؛ این ستون یکتای سراسری است: یک دامنه‌ی تأییدشده فقط یک فروشگاه
    verifiedHostname  String?      @unique @map("verified_hostname")
    isPrimary         Boolean      @default(false) @map("is_primary")
    status            DomainStatus @default(PENDING)
    /// مقدار داخل رکورد TXT اثبات مالکیت
    verificationToken String       @map("verification_token")
    verifiedAt        DateTime?    @map("verified_at") @db.Timestamptz(3)
    lastCheckedAt     DateTime?    @map("last_checked_at") @db.Timestamptz(3)
    /// تعداد دفعات پشت‌سرهم که بررسی روزانه‌ی TXT شکست خورده
    checkFailures     Int          @default(0) @map("check_failures")
    createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    @@unique([tenantId, hostname])
    @@index([hostname])
    @@index([tenantId])
    @@map("domains")
}

/// هر ردیف یک refresh token است (فقط هش آن ذخیره می‌شود)
model RefreshToken {
    id        String    @id @default(uuid(7)) @db.Uuid
    userId    String    @map("user_id") @db.Uuid
    /// همه‌ی توکن‌های یک نشست (زنجیره‌ی rotation) یک familyId دارند
    familyId  String    @map("family_id") @db.Uuid
    tokenHash String    @unique @map("token_hash")
    expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
    revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
    userAgent String?   @map("user_agent")
    ip        String?
    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([familyId])
    @@map("refresh_tokens")
}

model Category {
    id          String   @id @default(uuid(7)) @db.Uuid
    tenantId    String   @map("tenant_id") @db.Uuid
    parentId    String?  @map("parent_id") @db.Uuid
    name        String
    slug        String
    description String?
    position    Int      @default(0)
    createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
    children Category[] @relation("CategoryTree")
    products Product[]

    @@unique([tenantId, slug])
    @@index([tenantId, parentId])
    @@map("categories")
}

model Product {
    id          String        @id @default(uuid(7)) @db.Uuid
    tenantId    String        @map("tenant_id") @db.Uuid
    categoryId  String?       @map("category_id") @db.Uuid
    title       String
    slug        String
    description String?       @db.Text
    status      ProductStatus @default(DRAFT)
    /// کمترین/بیشترین قیمت تنوع‌ها (دِنرمال؛ همراه تغییر تنوع‌ها به‌روز می‌شود)
    minPrice    Int           @default(0) @map("min_price")
    maxPrice    Int           @default(0) @map("max_price")
    createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    category Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
    variants Variant[]
    images   ProductImage[]

    @@unique([tenantId, slug])
    /// لازم برای کلید خارجی ترکیبی Variant ← Product
    @@unique([tenantId, id])
    @@index([tenantId, status, createdAt])
    @@index([tenantId, categoryId])
    @@map("products")
}

model Variant {
    id             String   @id @default(uuid(7)) @db.Uuid
    tenantId       String   @map("tenant_id") @db.Uuid
    productId      String   @map("product_id") @db.Uuid
    title          String   @default("پیش‌فرض")
    sku            String?
    /// قیمت به کوچک‌ترین واحد پول (تومان)
    price          Int
    compareAtPrice Int?     @map("compare_at_price")
    position       Int      @default(0)
    createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    product   Product    @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
    inventory Inventory?
    cartItems CartItem[]

    @@unique([tenantId, sku])
    /// لازم برای کلید خارجی ترکیبی Inventory ← Variant
    @@unique([tenantId, id])
    @@index([productId])
    @@map("variants")
}

model Inventory {
    id             String   @id @default(uuid(7)) @db.Uuid
    tenantId       String   @map("tenant_id") @db.Uuid
    variantId      String   @map("variant_id") @db.Uuid
    quantity       Int      @default(0)
    allowBackorder Boolean  @default(false) @map("allow_backorder")
    updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    variant Variant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)

    @@unique([tenantId, variantId])
    @@map("inventory")
}

model Media {
    id           String   @id @default(uuid(7)) @db.Uuid
    tenantId     String   @map("tenant_id") @db.Uuid
    originalName String   @map("original_name")
    /// فرمت فایلی که آپلود شده (فایل ذخیره‌شده همیشه image/webp است)
    mimeType     String   @map("mime_type")
    sizeBytes    Int      @map("size_bytes")
    /// ابعاد بعد از اعمال چرخش EXIF
    width        Int
    height       Int
    alt          String?
    createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

    tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    productImages ProductImage[]

    /// لازم برای کلید خارجی ترکیبی ProductImage ← Media
    @@unique([tenantId, id])
    @@index([tenantId, createdAt])
    @@map("media")
}

model ProductImage {
    id        String @id @default(uuid(7)) @db.Uuid
    tenantId  String @map("tenant_id") @db.Uuid
    productId String @map("product_id") @db.Uuid
    mediaId   String @map("media_id") @db.Uuid
    position  Int    @default(0)

    tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
    media   Media   @relation(fields: [tenantId, mediaId], references: [tenantId, id], onDelete: Cascade)

    @@unique([productId, mediaId])
    @@index([mediaId])
    @@map("product_images")
}

/// مشتری نهایی یک فروشگاه (جدا از User فروشنده)
model Customer {
    id          String    @id @default(uuid(7)) @db.Uuid
    tenantId    String    @map("tenant_id") @db.Uuid
    /// موبایل نرمال‌شده: 09xxxxxxxxx
    phone       String
    name        String?
    lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
    createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    sessions CustomerSession[]
    carts    Cart[]

    addresses CustomerAddress[]
    orders    Order[]

    @@unique([tenantId, phone])
    /// لازم برای کلید خارجی ترکیبی CustomerSession ← Customer
    @@unique([tenantId, id])
    @@map("customers")
}

model CustomerSession {
    id         String   @id @default(uuid(7)) @db.Uuid
    tenantId   String   @map("tenant_id") @db.Uuid
    customerId String   @map("customer_id") @db.Uuid
    /// فقط هش SHA-256 توکن کوکی ذخیره می‌شود
    tokenHash  String   @unique @map("token_hash")
    expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
    userAgent  String?  @map("user_agent")
    ip         String?
    createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

    tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

    @@index([tenantId, customerId])
    @@index([expiresAt])
    @@map("customer_sessions")
}

/// سبد خرید: یا متعلق به مشتری (customerId) یا مهمان (tokenHash)
model Cart {
    id         String   @id @default(uuid(7)) @db.Uuid
    tenantId   String   @map("tenant_id") @db.Uuid
    customerId String?  @map("customer_id") @db.Uuid
    /// هش توکن کوکی sf_cart (فقط سبد مهمان)
    tokenHash  String?  @unique @map("token_hash")
    createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    /// کلید ساده (نه ترکیبی)، چون Prisma کلید ترکیبی با ستون اختیاری را نمی‌پذیرد؛
    /// مشتری همیشه از نشست همان فروشگاه گرفته می‌شود
    customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
    items    CartItem[]

    @@unique([tenantId, customerId])
    /// لازم برای کلید خارجی ترکیبی CartItem ← Cart
    @@unique([tenantId, id])
    @@index([updatedAt])
    @@map("carts")
}

model CartItem {
    id        String   @id @default(uuid(7)) @db.Uuid
    tenantId  String   @map("tenant_id") @db.Uuid
    cartId    String   @map("cart_id") @db.Uuid
    variantId String   @map("variant_id") @db.Uuid
    quantity  Int
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    cart    Cart    @relation(fields: [tenantId, cartId], references: [tenantId, id], onDelete: Cascade)
    variant Variant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)

    @@unique([cartId, variantId])
    @@index([variantId])
    @@map("cart_items")
}

model ShippingMethod {
    id            String   @id @default(uuid(7)) @db.Uuid
    tenantId      String   @map("tenant_id") @db.Uuid
    title         String
    description   String?
    /// هزینه‌ی ارسال (تومان)
    fee           Int
    /// اگر جمع سفارش به این مبلغ برسد، ارسال رایگان می‌شود
    freeThreshold Int?     @map("free_threshold")
    isActive      Boolean  @default(true) @map("is_active")
    position      Int      @default(0)
    createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    @@index([tenantId, isActive, position])
    @@map("shipping_methods")
}

model CustomerAddress {
    id             String   @id @default(uuid(7)) @db.Uuid
    tenantId       String   @map("tenant_id") @db.Uuid
    customerId     String   @map("customer_id") @db.Uuid
    recipientName  String   @map("recipient_name")
    recipientPhone String   @map("recipient_phone")
    province       String
    city           String
    address        String
    postalCode     String   @map("postal_code")
    isDefault      Boolean  @default(false) @map("is_default")
    createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

    @@index([tenantId, customerId])
    @@map("customer_addresses")
}

/// شمارنده‌ی شماره‌ی سفارش به ازای هر فروشگاه
model OrderCounter {
    tenantId   String @id @map("tenant_id") @db.Uuid
    lastNumber Int    @map("last_number")

    tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    @@map("order_counters")
}

model Order {
    id             String      @id @default(uuid(7)) @db.Uuid
    tenantId       String      @map("tenant_id") @db.Uuid
    /// شماره‌ی خوانا برای مشتری و فروشنده (یکتا در هر فروشگاه)
    number         Int
    customerId     String      @map("customer_id") @db.Uuid
    status         OrderStatus @default(PENDING)
    subtotal       Int
    shippingFee    Int         @map("shipping_fee")
    total          Int
    shippingTitle  String      @map("shipping_title")
    // snapshot آدرس تحویل (با ویرایش نشانی‌های ذخیره‌شده تغییر نمی‌کند)
    recipientName  String      @map("recipient_name")
    recipientPhone String      @map("recipient_phone")
    province       String
    city           String
    address        String
    postalCode     String      @map("postal_code")
    note           String?
    trackingCode   String?     @map("tracking_code")
    /// CUSTOMER | EXPIRED | SELLER
    cancelReason   String?     @map("cancel_reason")
    /// مهلت پرداخت (فقط برای PENDING)
    expiresAt      DateTime?   @map("expires_at") @db.Timestamptz(3)
    paidAt         DateTime?   @map("paid_at") @db.Timestamptz(3)
    shippedAt      DateTime?   @map("shipped_at") @db.Timestamptz(3)
    canceledAt     DateTime?   @map("canceled_at") @db.Timestamptz(3)
    createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    /// NoAction: حذف کل فروشگاه (Cascade) مشکلی ندارد، ولی حذف مشتریِ دارای سفارش خطا می‌دهد
    customer Customer    @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
    items    OrderItem[]

    payments Payment[]

    @@unique([tenantId, number])
    /// لازم برای کلید خارجی ترکیبی OrderItem ← Order
    @@unique([tenantId, id])
    @@index([tenantId, customerId, createdAt])
    @@index([tenantId, status, expiresAt])
    @@index([tenantId, status, createdAt])
    @@map("orders")
}

model OrderItem {
    id           String  @id @default(uuid(7)) @db.Uuid
    tenantId     String  @map("tenant_id") @db.Uuid
    orderId      String  @map("order_id") @db.Uuid
    /// بدون کلید خارجی: با حذف محصول یا تنوع، تاریخچه‌ی سفارش می‌ماند
    productId    String  @map("product_id") @db.Uuid
    variantId    String  @map("variant_id") @db.Uuid
    productSlug  String  @map("product_slug")
    productTitle String  @map("product_title")
    variantTitle String  @map("variant_title")
    sku          String?
    imageUrl     String? @map("image_url")
    unitPrice    Int     @map("unit_price")
    quantity     Int
    lineTotal    Int     @map("line_total")

    tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    order  Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)

    @@index([orderId])
    @@index([variantId])
    @@map("order_items")
}

/// تنظیم درگاه پرداخت هر فروشگاه؛ شناسه‌ی پذیرنده فقط به‌صورت رمزنگاری‌شده ذخیره می‌شود
model PaymentGatewayConfig {
    id            String         @id @default(uuid(7)) @db.Uuid
    tenantId      String         @map("tenant_id") @db.Uuid
    provider      PaymentGateway
    /// خروجی SecretBox: v1.<iv>.<tag>.<ciphertext>
    merchantIdEnc String         @map("merchant_id_enc")
    /// ۴ کاراکتر آخر شناسه، فقط برای نمایش به فروشنده
    merchantHint  String         @map("merchant_hint")
    isActive      Boolean        @default(true) @map("is_active")
    createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    @@unique([tenantId, provider])
    @@map("payment_gateway_configs")
}

/// یک تلاش پرداخت برای یک سفارش (هر سفارش می‌تواند چند تلاش داشته باشد)
model Payment {
    id            String         @id @default(uuid(7)) @db.Uuid
    tenantId      String         @map("tenant_id") @db.Uuid
    orderId       String         @map("order_id") @db.Uuid
    provider      PaymentGateway
    /// مبلغ (تومان) در لحظه‌ی شروع پرداخت؛ همان مبلغی که verify می‌شود
    amount        Int
    status        PaymentStatus  @default(INITIATED)
    authority     String
    refId         String?        @map("ref_id")
    cardPan       String?        @map("card_pan")
    /// آخرین کد پاسخ درگاه
    gatewayCode   Int?           @map("gateway_code")
    failureReason String?        @map("failure_reason")
    verifiedAt    DateTime?      @map("verified_at") @db.Timestamptz(3)
    createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    /// NoAction: سابقه‌ی مالی با حذف سفارش از بین نمی‌رود
    order  Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: NoAction)

    @@unique([tenantId, authority])
    @@index([tenantId, orderId])
    @@index([tenantId, status, createdAt])
    @@map("payments")
}

/// صفحه‌ی سایت‌ساز (صفحه‌ی اصلی با slug = home). محتوا آرایه‌ای از بلاک‌ها است.
model Page {
    id          String    @id @default(uuid(7)) @db.Uuid
    tenantId    String    @map("tenant_id") @db.Uuid
    slug        String
    title       String
    /// نسخه‌ی منتشرشده؛ فقط همین به بازدیدکننده نمایش داده می‌شود
    blocks      Json      @default("[]")
    /// پیش‌نویس در حال ویرایش؛ null یعنی تغییر منتشرنشده‌ای وجود ندارد
    draftBlocks Json?     @map("draft_blocks")
    /// null یعنی هنوز منتشر نشده (برای بازدیدکننده وجود ندارد)
    publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
    createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    @@unique([tenantId, slug])
    @@index([tenantId, publishedAt])
    @@map("pages")
}
