generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

enum TenantPlan {
    FREE
    BASIC
    PRO
}

enum TenantStatus {
    ACTIVE
    SUSPENDED
}

enum UserRole {
    OWNER
    ADMIN
    EDITOR
}

enum DomainStatus {
    PENDING
    VERIFIED
    FAILED
}

/// هر فروشگاه یک Tenant است
model Tenant {
    id        String       @id @default(uuid(7)) @db.Uuid
    name      String
    /// همیشه lowercase ذخیره شود (در لایه‌ی سرویس نرمال می‌کنیم)
    subdomain String       @unique
    plan      TenantPlan   @default(FREE)
    status    TenantStatus @default(ACTIVE)
    /// تنظیمات انعطاف‌پذیر (لوگو، رنگ، اطلاعات تماس و ...)
    settings  Json         @default("{}")
    createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

    users   User[]
    domains Domain[]

    @@map("tenants")
}

/// فروشنده و کارمندان او (نه مشتری نهایی فروشگاه)
model User {
    id            String         @id @default(uuid(7)) @db.Uuid
    tenantId      String         @map("tenant_id") @db.Uuid
    refreshTokens RefreshToken[]
    /// همیشه lowercase ذخیره شود
    email         String         @unique
    passwordHash  String         @map("password_hash")
    name          String
    role          UserRole       @default(EDITOR)
    isActive      Boolean        @default(true) @map("is_active")
    lastLoginAt   DateTime?      @map("last_login_at") @db.Timestamptz(3)
    createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    @@index([tenantId])
    @@map("users")
}

/// دامنه‌های اختصاصی متصل به فروشگاه
model Domain {
    id                String       @id @default(uuid(7)) @db.Uuid
    tenantId          String       @map("tenant_id") @db.Uuid
    /// مثلاً www.customer.ir (lowercase، بدون پروتکل)
    hostname          String       @unique
    isPrimary         Boolean      @default(false) @map("is_primary")
    status            DomainStatus @default(PENDING)
    /// مقداری که فروشنده باید در DNS (TXT) بگذارد؛ در روز ۱۶ تولید می‌شود
    verificationToken String       @map("verification_token")
    verifiedAt        DateTime?    @map("verified_at") @db.Timestamptz(3)
    createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

    tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    @@index([tenantId])
    @@map("domains")
}

/// هر ردیف یک refresh token است (فقط هش آن ذخیره می‌شود)
model RefreshToken {
    id        String    @id @default(uuid(7)) @db.Uuid
    userId    String    @map("user_id") @db.Uuid
    /// همه‌ی توکن‌های یک نشست (زنجیره‌ی rotation) یک familyId دارند
    familyId  String    @map("family_id") @db.Uuid
    tokenHash String    @unique @map("token_hash")
    expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
    revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
    userAgent String?   @map("user_agent")
    ip        String?
    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([familyId])
    @@map("refresh_tokens")
}
